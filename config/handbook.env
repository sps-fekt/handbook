# Runtime settings of the handbook container, read through EnvironmentFile= in handbook.quadlets.
# Changing this file restarts the site on the next deploy, without rebuilding the image.
# Secrets don't belong here: they are Podman secrets (see README.md).

# Public URL of the site, without a trailing slash.
NUXT_SITE_URL=https://handbook.sps-fekt.cz

# The repository and branch the site reads its pages from.
NUXT_DOCS_GITHUB_OWNER=sps-fekt
NUXT_DOCS_GITHUB_REPO=handbook
NUXT_DOCS_GITHUB_BRANCH=main

# The comark-docs layer is made for Vercel: only with VERCEL_ENV=production does it
# switch to a new content commit while running (on the webhook, or within an hour).
# Without it, the site serves the content it started with until it restarts.
VERCEL_ENV=production

# The GitHub OAuth app the page editor (/cs/editor) signs in with (README.md,
# Setup; nuxt-auth-utils). Its secret is a Podman secret. The callback is spelled
# out: behind the reverse proxy the request says http.
NUXT_OAUTH_GITHUB_CLIENT_ID=Ov23lidSHYKviuouFQQh
NUXT_OAUTH_GITHUB_REDIRECT_URL=https://handbook.sps-fekt.cz/editor/login
