# Runtime settings of the handbook container, read through EnvironmentFile= in handbook.quadlets.
# Changing this file restarts the site on the next deploy, without rebuilding the image.
# Secrets don't belong here: they are Podman secrets (see README.md).

# Public URL of the site, without a trailing slash.
NUXT_SITE_URL=https://prirucka.sps-fekt.cz

# The repository and branch the site reads its pages from.
NUXT_DOCS_GITHUB_OWNER=sps-fekt
NUXT_DOCS_GITHUB_REPO=handbook
NUXT_DOCS_GITHUB_BRANCH=main
