[Unit]
Description=Check GitHub for handbook updates every 10 minutes

# A fallback: a push to GitHub deploys right away (.github/workflows/deploy.yml
# starts handbook-deploy.service over SSH), this catches what that misses.

[Timer]
OnBootSec=2min
OnUnitActiveSec=10min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
